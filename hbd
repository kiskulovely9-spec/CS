<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Happy 25th, Cindy!</title>
<style>
  :root{
    --kraft-1: #e6d5ad;
    --kraft-2: #d8c194;
    --kraft-edge: #b89f6e;
    --ink: #7a2e2e;
    --paper: #fdf8ec;
    --red: #a31d1d;
    --page-w: 300px;
    --page-h: 450px;
  }
  @media (min-width: 700px){
    :root{ --page-w: 340px; --page-h: 510px; }
  }

  *{ box-sizing: border-box; }

  html,body{
    margin:0; padding:0; min-height:100%;
    width: 100%;
    font-family: 'Courier New', Courier, monospace;
    overflow-x: hidden;
  }

  body{
    background:
      radial-gradient(circle at 15% 20%, rgba(255,255,255,0.10), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(0,0,0,0.06), transparent 45%),
      repeating-linear-gradient(0deg, rgba(120,90,40,0.035) 0px, rgba(120,90,40,0.035) 1px, transparent 1px, transparent 3px),
      linear-gradient(160deg, var(--kraft-1), var(--kraft-2));
    min-height: 100vh;
    display:flex;
    flex-direction: column;
    align-items:center;
    color:var(--ink);
  }

  .stage{
    width:100%;
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-start;
    padding-top: 9vh;
    padding-bottom: 6vh;
  }

  .hint{
    margin-top: 22px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--ink);
    opacity:0.65;
    text-align:center;
    padding: 0 20px;
  }

  /* ---------------- COVER ---------------- */
  .perspective-wrap{
    perspective: 2200px;
    display:flex;
    justify-content:center;
  }

  .cover-card{
    width: var(--page-w);
    height: var(--page-h);
    border-radius: 6px;
    overflow:hidden;
    cursor:pointer;
    box-shadow: 0 18px 40px rgba(60,30,10,0.35), 0 3px 10px rgba(60,30,10,0.25);
    transform-origin: left center;
    transition: transform 0.7s cubic-bezier(.6,.1,.3,1), opacity 0.6s ease 0.15s, box-shadow 0.5s ease;
    background: #a31d1d;
    position:relative;
    animation: coverIn 0.7s cubic-bezier(.2,.8,.3,1) both;
  }

  @keyframes coverIn{
    from{ opacity:0; transform: translateY(18px) scale(0.96); }
    to{ opacity:1; transform: translateY(0) scale(1); }
  }

  .cover-card:active{ transform: scale(0.985); }

  .cover-card.opening{
    transform: rotateY(-92deg) translateX(-6px);
    opacity: 0;
    box-shadow: none;
    pointer-events:none;
  }

  .cover-card img{
    width:100%; height:100%; object-fit:cover; display:block;
    -webkit-user-drag:none; user-select:none;
    pointer-events:none;
  }

  .tap-badge{
    position:absolute;
    bottom: 14px; left:50%;
    transform: translateX(-50%);
    background: rgba(20,10,5,0.45);
    color:#f5e9c9;
    font-size:11px;
    letter-spacing:0.12em;
    padding: 7px 14px;
    border-radius:20px;
    animation: pulseBadge 2s ease-in-out infinite;
    white-space:nowrap;
  }
  @keyframes pulseBadge{
    0%,100%{ opacity:0.75; transform: translateX(-50%) translateY(0); }
    50%{ opacity:1; transform: translateX(-50%) translateY(-3px); }
  }

  .hidden{ display:none !important; }

  /* ---------------- SPREAD ---------------- */
  .spread-outer{
    display:flex;
    flex-direction:column;
    align-items:center;
    opacity:0;
    transform: translateY(14px) scale(0.97);
    animation: spreadIn 0.6s cubic-bezier(.2,.8,.3,1) 0.35s both;
  }
  @keyframes spreadIn{
    to{ opacity:1; transform: translateY(0) scale(1); }
  }

  .spread{
    display:flex;
    box-shadow: 0 24px 55px rgba(50,25,10,0.4);
    border-radius: 6px;
    overflow:hidden;
    position:relative;
  }

  .spread::after{
    content:"";
    position:absolute;
    top:0; bottom:0; left:50%;
    width: 14px;
    margin-left:-7px;
    background: linear-gradient(90deg, rgba(0,0,0,0.16), rgba(0,0,0,0.02) 30%, rgba(0,0,0,0.02) 70%, rgba(0,0,0,0.16));
    pointer-events:none;
    z-index: 5;
  }

  .page{
    width: var(--page-w);
    height: var(--page-h);
    position:relative;
    overflow:hidden;
    background:#a31d1d;
  }

  .page-left{ border-radius: 6px 0 0 6px; }
  .page-right{ border-radius: 0 6px 6px 0; }

  .page-bg{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover;
    display:block;
    pointer-events:none;
    -webkit-user-drag:none; user-select:none;
  }

  .back-btn{
    margin-top: 22px;
    background: transparent;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    font-family:inherit;
    font-size: 12px;
    letter-spacing:0.08em;
    padding: 9px 18px;
    border-radius: 20px;
    cursor:pointer;
    opacity:0.8;
    transition: opacity 0.2s ease, transform 0.15s ease, background 0.2s ease;
  }
  .back-btn:hover{ opacity:1; background: rgba(122,46,46,0.08); }
  .back-btn:active{ transform: scale(0.96); }

  /* ---------------- LETTER PAGE ---------------- */
  .letter-page{ cursor:pointer; }

  .letter-full-wrap{
    position:absolute;
    left: 6%; right:6%;
    top: 5%; bottom: 5%;
    display:flex;
    align-items:center;
    justify-content:center;
    transform: translateY(46%) scale(0.88);
    opacity:0;
    transition: transform 0.55s cubic-bezier(.2,.8,.25,1), opacity 0.4s ease;
    z-index:3;
    pointer-events:none;
  }
  .letter-page.open .letter-full-wrap{
    transform: translateY(0) scale(1);
    opacity:1;
    pointer-events:auto;
  }

  .letter-full{
    width:100%;
    height:100%;
    background: var(--paper);
    border-radius: 3px;
    box-shadow: 0 14px 30px rgba(40,15,10,0.45);
    overflow:auto;
    -webkit-overflow-scrolling: touch;
  }
  .letter-full img{
    width:100%;
    display:block;
  }

  .letter-page-hint{
    position:absolute;
    bottom: 8%;
    left:50%;
    transform: translateX(-50%);
    background: rgba(20,10,5,0.45);
    color:#f5e9c9;
    font-size:10.5px;
    letter-spacing:0.1em;
    padding: 6px 12px;
    border-radius:16px;
    z-index:4;
    transition: opacity 0.3s ease;
    pointer-events:none;
    white-space:nowrap;
  }
  .letter-page.open .letter-page-hint{ opacity:0; }

  /* ---------------- CANDLES PAGE ---------------- */
  .candles-page{ }

  .flame{
    position:absolute;
    transform-origin: 50% 100%;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.25));
    animation: flicker 1.6s ease-in-out infinite;
    pointer-events:none;
    transition: opacity 0.35s ease;
  }
  .flame img{ width:100%; height:100%; display:block; }

  .flame-left{
    left: 34.0%; top: 38.6%;
    width: 7.5%; height: 8.33%;
    transform-origin: 51.3% 100%;
    animation-delay: 0s;
  }
  .flame-right{
    left: 60.2%; top: 39.2%;
    width: 7.2%; height: 8.27%;
    transform-origin: 41.7% 100%;
    animation-delay: 0.35s;
  }

  @keyframes flicker{
    0%,100%{ transform: rotate(-2deg) scaleY(1); }
    25%{ transform: rotate(1.5deg) scaleY(1.04); }
    50%{ transform: rotate(-1deg) scaleY(0.97); }
    75%{ transform: rotate(2deg) scaleY(1.02); }
  }

  .flame.blowing{
    animation: none !important;
  }

  .flame.out{
    opacity:0;
  }

  .smoke{
    position:absolute;
    width: 3px;
    border-radius: 3px;
    background: rgba(180,180,180,0.0);
    pointer-events:none;
  }
  .smoke.show{
    animation: smokeUp 1.1s ease-out forwards;
  }
  @keyframes smokeUp{
    0%{ opacity:0.55; height:0; background:rgba(170,170,170,0.55); transform: translateY(0) translateX(0) scaleX(1); }
    100%{ opacity:0; height:46px; transform: translateY(-46px) translateX(8px) scaleX(2.4); }
  }

  .mic-ui{
    position:absolute;
    left:0; right:0; bottom: 0;
    padding: 12px 14px 14px;
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:8px;
    z-index:6;
    background: linear-gradient(0deg, rgba(20,8,5,0.35), rgba(20,8,5,0));
  }

  .meter{
    width: 78%;
    max-width: 220px;
    height: 8px;
    background: rgba(255,255,255,0.35);
    border-radius: 6px;
    overflow:hidden;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.25);
  }
  .meter-fill{
    height:100%;
    width:0%;
    background: linear-gradient(90deg, #f4b93e, #e2543a);
    transition: width 0.08s linear;
  }

  .mic-status{
    font-size: 10.5px;
    color: #fff6e6;
    letter-spacing:0.06em;
    text-shadow: 0 1px 3px rgba(0,0,0,0.5);
    text-align:center;
  }

  .blow-btn{
    margin-top: 2px;
    background: rgba(163,29,29,0.85);
    color: #fff6e6;
    border: 1.5px solid rgba(255,246,230,0.7);
    font-family:inherit;
    font-size: 11.5px;
    letter-spacing:0.08em;
    padding: 8px 16px;
    border-radius: 18px;
    cursor:pointer;
    user-select:none;
    -webkit-user-select:none;
    touch-action: manipulation;
  }
  .blow-btn:active{ background: rgba(120,20,20,0.9); }

  .wish-overlay{
    position:absolute; inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    gap:14px;
    text-align:center;
    background: rgba(30,12,8,0.28);
    opacity:0;
    pointer-events:none;
    transition: opacity 0.5s ease;
    z-index:7;
    padding: 20px;
  }
  .wish-overlay.show{
    opacity:1;
    pointer-events:auto;
  }

  .wish-text{
    color:#fff8ea;
    font-size: 19px;
    font-weight:bold;
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
    line-height:1.4;
    max-width: 85%;
  }

  .relight-btn{
    background: #fff8ea;
    color: var(--red);
    border:none;
    font-family:inherit;
    font-weight:bold;
    font-size: 12px;
    letter-spacing:0.06em;
    padding: 9px 18px;
    border-radius:18px;
    cursor:pointer;
    box-shadow: 0 6px 14px rgba(0,0,0,0.3);
  }
  .relight-btn:active{ transform: scale(0.96); }

  canvas.confetti{
    position:absolute; inset:0;
    width:100%; height:100%;
    pointer-events:none;
    z-index:8;
  }

  .https-note{
    max-width: 320px;
    margin-top: 16px;
    font-size: 11px;
    line-height:1.5;
    opacity:0.6;
    text-align:center;
    padding: 0 16px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
  }
</style>
</head>
<body>

<div class="stage">

  <div class="perspective-wrap" id="coverWrap">
    <div class="cover-card" id="coverCard" role="button" tabindex="0" aria-label="Open birthday card">
      <img src="data:image/jpeg;base64," alt="Cover">
      <div class="tap-badge">tap to open</div>
    </div>
  </div>
  <div class="hint" id="coverHint">a little something for your 25th 🎈</div>

  <div class="spread-outer hidden" id="spreadOuter">
    <div class="spread">
      <div class="page page-left letter-page" id="letterPage">
        <img class="page-bg" src="data:image/jpeg;base64," alt="Envelope with letter">
        <div class="letter-page-hint">tap the letter to read</div>
        <div class="letter-full-wrap">
          <div class="letter-full">
            <img src="data:image/png;base64," alt="Full letter">
          </div>
        </div>
      </div>

      <div class="page page-right candles-page" id="candlesPage">
        <img class="page-bg" src="data:image/jpeg;base64," alt="Cake">

        <div class="flame flame-left" id="flameLeft">
          <img src="data:image/png;base64," alt="">
        </div>
        <div class="flame flame-right" id="flameRight">
          <img src="data:image/png;base64," alt="">
        </div>

        <canvas class="confetti" id="confettiCanvas"></canvas>

        <div class="wish-overlay" id="wishOverlay">
          <div class="wish-text">make a wish, Cindy 🎂</div>
          <button class="relight-btn" id="relightBtn">relight the candles</button>
        </div>

        <div class="mic-ui" id="micUi">
          <div class="meter"><div class="meter-fill" id="meterFill"></div></div>
          <div class="mic-status" id="micStatus">blow into your mic to blow out the candles</div>
          <button class="blow-btn" id="blowBtn">hold to blow (fallback)</button>
        </div>
      </div>
    </div>

    <button class="back-btn" id="backBtn">← back to cover</button>
  </div>

  <div class="https-note" id="httpsNote">psst — the mic only works when this is opened over https (i.e. hosted online), not opened straight from a local file. if the mic's blocked, use the hold-to-blow button or hold the spacebar instead.</div>

</div>

<script>
(function(){
  "use strict";

  var NAME = "Cindy";

  var coverCard = document.getElementById('coverCard');
  var coverWrap = document.getElementById('coverWrap');
  var coverHint = document.getElementById('coverHint');
  var spreadOuter = document.getElementById('spreadOuter');
  var backBtn = document.getElementById('backBtn');
  var letterPage = document.getElementById('letterPage');
  var candlesPage = document.getElementById('candlesPage');

  function openCard(){
    coverCard.classList.add('opening');
    coverHint.classList.add('hidden');
    setTimeout(function(){
      coverWrap.classList.add('hidden');
      coverHint.classList.add('hidden');
      spreadOuter.classList.remove('hidden');
      // restart entrance animation
      spreadOuter.style.animation = 'none';
      void spreadOuter.offsetWidth;
      spreadOuter.style.animation = '';
      initCandlesOnce();
    }, 680);
  }

  function closeCard(){
    spreadOuter.classList.add('hidden');
    coverWrap.classList.remove('hidden');
    coverHint.classList.remove('hidden');
    coverCard.classList.remove('opening');
    coverCard.style.animation = 'none';
    void coverCard.offsetWidth;
    coverCard.style.animation = '';
    // reset letter + candles state for next time
    letterPage.classList.remove('open');
    relight();
  }

  coverCard.addEventListener('click', openCard);
  coverCard.addEventListener('keydown', function(e){
    if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openCard(); }
  });
  backBtn.addEventListener('click', closeCard);

  // ---------------- Letter interaction ----------------
  letterPage.addEventListener('click', function(e){
    letterPage.classList.toggle('open');
  });

  // ---------------- Candles / blow detection ----------------
  var flameLeft = document.getElementById('flameLeft');
  var flameRight = document.getElementById('flameRight');
  var flames = [flameLeft, flameRight];
  var meterFill = document.getElementById('meterFill');
  var micStatus = document.getElementById('micStatus');
  var blowBtn = document.getElementById('blowBtn');
  var wishOverlay = document.getElementById('wishOverlay');
  var relightBtn = document.getElementById('relightBtn');
  var confettiCanvas = document.getElementById('confettiCanvas');

  var audioCtx = null, analyser = null, micStream = null, micData = null;
  var micActive = false;
  var candlesOut = false;
  var blowLevel = 0;          // smoothed 0..1
  var blowingSince = null;    // timestamp when sustained blow started
  var BLOW_THRESHOLD = 0.16;  // smoothed level needed to count as "blowing"
  var BLOW_HOLD_MS = 500;
  var rafId = null;
  var initedCandles = false;

  var fallbackActive = false;
  var fallbackStart = null;

  function initCandlesOnce(){
    if(initedCandles) return;
    initedCandles = true;
    startMic();
    requestAnimationFrame(loop);
  }

  function startMic(){
    if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
      micStatus.textContent = 'mic not available here — use the button below';
      return;
    }
    navigator.mediaDevices.getUserMedia({ audio: true })
      .then(function(stream){
        micStream = stream;
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        var source = audioCtx.createMediaStreamSource(stream);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 512;
        analyser.smoothingTimeConstant = 0.6;
        micData = new Uint8Array(analyser.frequencyBinCount);
        source.connect(analyser);
        micActive = true;
        micStatus.textContent = 'blow into your mic to blow out the candles';
      })
      .catch(function(err){
        micActive = false;
        micStatus.textContent = 'mic blocked — use the button below (or hold spacebar)';
      });
  }

  function getMicLevel(){
    if(!micActive || !analyser) return 0;
    analyser.getByteTimeDomainData(micData);
    var sum = 0;
    for(var i=0;i<micData.length;i++){
      var v = (micData[i]-128)/128;
      sum += v*v;
    }
    var rms = Math.sqrt(sum/micData.length);
    return Math.min(1, rms*3.2);
  }

  function loop(ts){
    rafId = requestAnimationFrame(loop);
    if(candlesOut) return;

    var rawLevel = 0;
    if(fallbackActive){
      rawLevel = 0.9;
    } else if(micActive){
      rawLevel = getMicLevel();
    }

    blowLevel += (rawLevel - blowLevel) * 0.35;
    meterFill.style.width = Math.min(100, blowLevel*140) + '%';

    var isBlowing = blowLevel > BLOW_THRESHOLD;

    if(isBlowing){
      if(blowingSince === null) blowingSince = ts || performance.now();
      var elapsed = (ts || performance.now()) - blowingSince;
      var bendAmt = Math.min(1, elapsed/BLOW_HOLD_MS) * (0.6 + blowLevel*0.4);
      applyBend(bendAmt);
      if(elapsed >= BLOW_HOLD_MS){
        blowOutCandles();
      }
    } else {
      blowingSince = null;
      applyBend(0);
    }
  }

  function applyBend(amount){
    // amount 0..1 -> bend flames sideways, override flicker while blowing
    flames.forEach(function(f, idx){
      if(amount > 0.02){
        f.classList.add('blowing');
        var dir = idx === 0 ? 1 : -1;
        var deg = dir * (14 + amount*26);
        var scaleY = 1 - amount*0.28;
        f.style.transform = 'rotate('+deg+'deg) scaleY('+scaleY+')';
      } else {
        f.classList.remove('blowing');
        f.style.transform = '';
      }
    });
  }

  function blowOutCandles(){
    if(candlesOut) return;
    candlesOut = true;
    blowingSince = null;
    flames.forEach(function(f){
      f.classList.add('out');
      f.style.transform = '';
    });
    spawnSmoke(flameLeft);
    spawnSmoke(flameRight);
    stopFallback();
    setTimeout(function(){
      wishOverlay.classList.add('show');
      launchConfetti();
    }, 350);
  }

  function spawnSmoke(flameEl){
    var s = document.createElement('div');
    s.className = 'smoke show';
    var rect = flameEl.getBoundingClientRect();
    var parentRect = candlesPage.getBoundingClientRect();
    s.style.left = (rect.left - parentRect.left + rect.width*0.45) + 'px';
    s.style.top = (rect.top - parentRect.top) + 'px';
    candlesPage.appendChild(s);
    setTimeout(function(){ s.remove(); }, 1200);
  }

  function relight(){
    candlesOut = false;
    blowLevel = 0;
    blowingSince = null;
    flames.forEach(function(f){
      f.classList.remove('out');
      f.classList.remove('blowing');
      f.style.transform = '';
    });
    wishOverlay.classList.remove('show');
    meterFill.style.width = '0%';
  }

  relightBtn.addEventListener('click', relight);

  // ---------------- Hold-to-blow fallback (button + spacebar) ----------------
  function startFallback(){
    if(candlesOut) return;
    fallbackActive = true;
    micStatus.textContent = 'blowing...';
  }
  function stopFallback(){
    fallbackActive = false;
    if(!candlesOut) micStatus.textContent = micActive ? 'blow into your mic to blow out the candles' : 'mic blocked — use the button below (or hold spacebar)';
  }

  blowBtn.addEventListener('pointerdown', function(e){ e.preventDefault(); startFallback(); });
  blowBtn.addEventListener('pointerup', stopFallback);
  blowBtn.addEventListener('pointerleave', stopFallback);
  blowBtn.addEventListener('pointercancel', stopFallback);

  window.addEventListener('keydown', function(e){
    if(e.code === 'Space' && !spreadOuter.classList.contains('hidden')){
      e.preventDefault();
      startFallback();
    }
  });
  window.addEventListener('keyup', function(e){
    if(e.code === 'Space'){ stopFallback(); }
  });

  // resize confetti canvas to its container
  function sizeCanvas(){
    var rect = candlesPage.getBoundingClientRect();
    confettiCanvas.width = rect.width;
    confettiCanvas.height = rect.height;
  }
  window.addEventListener('resize', sizeCanvas);

  function launchConfetti(){
    sizeCanvas();
    var ctx = confettiCanvas.getContext('2d');
    var W = confettiCanvas.width, H = confettiCanvas.height;
    var colors = ['#e2543a','#f4b93e','#f2a9c1','#8fb7a8','#fdf8ec','#a31d1d'];
    var pieces = [];
    var n = 70;
    for(var i=0;i<n;i++){
      pieces.push({
        x: Math.random()*W,
        y: -20 - Math.random()*H*0.5,
        w: 5+Math.random()*5,
        h: 8+Math.random()*6,
        rot: Math.random()*Math.PI*2,
        vRot: (Math.random()-0.5)*0.3,
        vy: 2+Math.random()*2.5,
        vx: (Math.random()-0.5)*1.6,
        color: colors[Math.floor(Math.random()*colors.length)]
      });
    }
    var start = performance.now();
    var duration = 3200;
    function frame(ts){
      var elapsed = ts-start;
      ctx.clearRect(0,0,W,H);
      var alive = false;
      pieces.forEach(function(p){
        if(p.y < H+20){ alive = true; }
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vRot;
        ctx.save();
        ctx.translate(p.x,p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);
        ctx.restore();
      });
      if(alive && elapsed < duration+1500){
        requestAnimationFrame(frame);
      } else {
        ctx.clearRect(0,0,W,H);
      }
    }
    requestAnimationFrame(frame);
  }

})();
</script>

